<Window x:Class="SseWpfApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sunucu Bağlantı Ayarları" Height="230" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#FFFFFF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sunucu Adresi -->
        <TextBlock Grid.Row="0" Text="Sunucu Adresi (SSE URL):" Foreground="#AAAAAA" Margin="0,0,0,5"/>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="txtServerUrl" Grid.Column="0" VerticalContentAlignment="Center" Padding="8,5" Background="#2D2D30" Foreground="#FFFFFF" BorderBrush="#3F3F46"/>
            <Button Name="btnOtomatikBul" Grid.Column="1" Content="🔍 Otomatik Bul" Click="btnOtomatikBul_Click" 
                    Margin="8,0,0,0" Padding="12,0" Height="30" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <!-- Windows Başlangıcında Çalıştır CheckBox -->
        <CheckBox x:Name="ChkAutoStart" 
                  Grid.Row="2"
                  Content="Windows açılışında otomatik başlat" 
                  Margin="0,0,0,0"
                  Foreground="#FFFFFF"
                  Cursor="Hand" />

        <!-- Butonlar -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"> 
            <Button Name="btnKaydet" Content="Kaydet" Click="btnKaydet_Click" Width="90" Height="30" Background="#007ACC" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
            <Button Name="btnIptal" Content="İptal" Click="btnIptal_Click" Width="90" Height="30" Background="#3F3F46" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
