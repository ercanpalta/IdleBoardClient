<Window x:Class="SseWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSE Canlı Resim Akışı" Height="1080" Width="1920"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        Background="#000000"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <!-- Resim Ekranın Tamamını Kaplar -->
        <Image x:Name="imgCanli" 
               Stretch="Uniform" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               Opacity="1"/>

        <!-- Video Oynatıcı (Ses Kapalı) -->
        <MediaElement x:Name="mediaVideo"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      ScrubbingEnabled="True"
                      Volume="0"
                      IsMuted="True"
                      Visibility="Collapsed"
                      MediaOpened="MediaVideo_MediaOpened"
                      MediaEnded="MediaVideo_MediaEnded"
                      MediaFailed="MediaVideo_MediaFailed"/>

        <!-- Sol Üst Marka Logosu / Filigran (Watermark) -->
        <Border x:Name="WatermarkPanel"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="30,26"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Image x:Name="ImgWatermark"
                   MaxWidth="260"
                   MaxHeight="100"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
        </Border>

        <!-- Alt Bilgi Şeridi (Overlay Banner) -->
        <Border x:Name="BottomBanner"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Stretch"
            Background="#CC000000"
            Padding="20,10">
            <Grid>
                <!-- Sol Kenara Hizalanmış Canlı/Çevrimdışı Durumu -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse x:Name="DotStatus" Width="10" Height="10" Fill="#EAB308" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus"
                               Text="Bağlantı Kuruluyor..."
                               Foreground="#E2E8F0"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Sağ Kenara Hizalanmış Tarih ve Saat -->
                <TextBlock x:Name="TxtSystemClock"
                       Text="19 Eylül 2026, Cumartesi — 00:00:00"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>