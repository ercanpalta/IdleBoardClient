<Window x:Class="SseWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSE Canlı Resim Akışı" Height="1080" Width="1920"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        Background="#000000"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <!-- Resim Ekranın Tamamını Kaplar -->
        <Image x:Name="imgCanli" 
               Stretch="Uniform" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               Opacity="1"/>

        <!-- Alt Bilgi Şeridi (Overlay Banner) -->
        <Border VerticalAlignment="Bottom"
            HorizontalAlignment="Stretch"
            Background="#CC000000"
            Padding="20,10">
            <Grid>
                <!-- Sağ Kenara Hizalanmış Tarih ve Saat -->
                <TextBlock x:Name="TxtSystemClock"
                       Text="19 Eylül 2026, Cumartesi — 00:00:00"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>