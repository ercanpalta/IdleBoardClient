<Window x:Class="SseWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSE Canlı Resim Akışı" Height="1080" Width="1920"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        Background="#000000"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <!-- Boşta / Yayın Akışı Bekleme Paneli (Hiçbir görsel yokken siyah ekran kalmasını önleyen zarif bekleme ekranı) -->
        <Grid x:Name="StandbyPanel" Visibility="Visible" Background="#060913">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="#1E293B" CornerRadius="12" Padding="24,10" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="IdleBoard" Foreground="#38BDF8" FontSize="22" FontWeight="Bold"/>
                </Border>
                <TextBlock x:Name="TxtStandbyText" Text="Yayın Akışı Bekleniyor..." Foreground="#64748B" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Resim Ekranın Tamamını Kaplar -->
        <Image x:Name="imgCanli" 
               Stretch="Uniform" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               Opacity="1"/>

        <!-- Video Oynatıcı (Ses Kapalı) -->
        <MediaElement x:Name="mediaVideo"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      ScrubbingEnabled="True"
                      Volume="0"
                      IsMuted="True"
                      Visibility="Collapsed"
                      MediaOpened="MediaVideo_MediaOpened"
                      MediaEnded="MediaVideo_MediaEnded"
                      MediaFailed="MediaVideo_MediaFailed"/>

        <!-- Sol Üst Marka Logosu / Filigran (Watermark) -->
        <Border x:Name="WatermarkPanel"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="30,26"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Image x:Name="ImgWatermark"
                   MaxWidth="260"
                   MaxHeight="100"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
        </Border>

        <!-- Alt Bilgi Şeridi (Overlay Banner) -->
        <Border x:Name="BottomBanner"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Stretch"
            Background="#CC000000"
            Padding="20,10">
            <Grid>
                <!-- Sol Kenara Hizalanmış Canlı/Çevrimdışı Durumu -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse x:Name="DotStatus" Width="10" Height="10" Fill="#EAB308" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus"
                               Text="Bağlantı Kuruluyor..."
                               Foreground="#E2E8F0"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Sağ Kenara Hizalanmış Tarih ve Saat -->
                <TextBlock x:Name="TxtSystemClock"
                       Text="19 Eylül 2026, Cumartesi — 00:00:00"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Açılış Eşitleme / Yükleniyor Ekranı -->
        <Grid x:Name="LoadingOverlay" Background="#0A0F1D" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <Border Background="#1E293B" CornerRadius="8" Padding="14,6" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="IdleBoard" Foreground="#38BDF8" FontSize="15" FontWeight="Bold"/>
                </Border>
                <ProgressBar x:Name="LoadingProgressBar" IsIndeterminate="True" Width="280" Height="6" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0" Margin="0,0,0,24"/>
                <TextBlock x:Name="TxtLoadingTitle" Text="Veriler alınıyor..." Foreground="White" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtLoadingStatus" Text="Sunucu ile eşitleniyor, lütfen bekleyin..." Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>